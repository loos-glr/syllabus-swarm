# ============================================================
# syllabus-swarm — Environment Configuration
# ============================================================
# Copy this file to ".env" and fill in your actual values.
#   cp .env.example .env
#
# The ".env" file is git-ignored and must NEVER be committed.

# --- OpenRouter API -------------------------------------------------
# Sign up at https://openrouter.ai/ and generate an API key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================
#  Per-Agent Model Configuration  (Issue #5 / Issue #6)
# ============================================================
#
#  Naming convention:  AGENT_{ROLE}_{PROPERTY}
#  ─────────────────────────────────────────────
#    {ROLE}      → uppercase snake_case of the agent role
#                   e.g. CURRICULUM_ARCHITECT, LAB_DEVELOPER, OUTPUT_EXPORTER
#    {PROPERTY}  → MODEL, TEMPERATURE, MAX_TOKENS, TOP_P
#
#  Fallback priority (highest to lowest):
#    1. AGENT_{ROLE}_{PROPERTY}   ← per-agent override, most specific
#    2. AGENT_DEFAULT_{PROPERTY}  ← catch-all default for all agents
#    3. Hardcoded defaults        ← values baked into src/llm_factory.py
#
#  All models are served via OpenRouter (https://openrouter.ai/api/v1).
#  See https://openrouter.ai/models for available model identifiers.

# --- OpenRouter base URL (defaults below) ---------------------------
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Default Agent Configuration (catch-all fallback) ---------------
# Every agent that does *not* have a per-agent override will use
# these defaults.  They replace the legacy OPENROUTER_MODEL /
# AGENT_TEMPERATURE / AGENT_MAX_TOKENS globals.
AGENT_DEFAULT_MODEL=openrouter/deepseek/deepseek-v4-pro
#     ^^^ Catch-all default for all agents.  Keeping deepseek-v4-pro ensures
#         any agent without an explicit override (including future agents
#         added later) continues to function with strong reasoning
#         capabilities.  Per-agent overrides below are the recommended
#         forward path.
AGENT_DEFAULT_TEMPERATURE=0.2
#     ^^^ Low temperature for deterministic, reproducible output
#          across all agents.  0.0 = fully deterministic, 1.0 = creative.
AGENT_DEFAULT_MAX_TOKENS=32768
#     ^^^ Maximum completion tokens per agent call.
#          Reasoning models (Claude Opus 5.5, Sonnet 5) need >= 16384
#          because adaptive reasoning consumes ~8K tokens internally.

# --- Per-Agent Overrides (takes precedence over defaults above) -----

# -- Curriculum Architect --
# Needs structured pedagogical output paired with strong reasoning.
# deepseek-v4-pro excels at designing coherent syllabi that weave
# together the Humanics framework (data literacy, tech literacy,
# human literacy) with experiential-learning pedagogy, producing
# well-organized, hierarchical curriculum structures.
# IMPORTANT: When using Claude Opus 5.5, max_tokens MUST be >= 16384
# because adaptive reasoning consumes ~8K tokens before content output.
AGENT_CURRICULUM_ARCHITECT_MODEL=openrouter/deepseek/deepseek-v4-pro
AGENT_CURRICULUM_ARCHITECT_TEMPERATURE=0.2
AGENT_CURRICULUM_ARCHITECT_MAX_TOKENS=32768

# -- Lab & Project Developer --
# Needs code-generation precision with correctness, syntax accuracy,
# and multi-file scaffolding capability.  qwen3-coder is purpose-built
# for programming tasks — it produces cleaner starter code, more
# accurate solution keys, and handles multi-file project scaffolding
# better than a general-purpose model.
AGENT_LAB_DEVELOPER_MODEL=openrouter/qwen/qwen3-coder
AGENT_LAB_DEVELOPER_TEMPERATURE=0.1
#     ^^^ Even lower temperature for code: we want consistent,
#          correct syntax, not creative variation.
# AGENT_LAB_DEVELOPER_MAX_TOKENS=8192          ← inherits from default

# -- Output Exporter --
# Needs lightweight, fast, cost-effective file I/O.  deepseek-v4-flash
# is the ideal choice for formatting, file-tree generation, and
# Markdown assembly — it delivers reliable structured output at a
# fraction of the cost of full reasoning models.
AGENT_OUTPUT_EXPORTER_MODEL=openrouter/deepseek/deepseek-v4-flash-latest
AGENT_OUTPUT_EXPORTER_TEMPERATURE=0.0
#     ^^^ Fully deterministic: export formatting should never vary
#          between runs.
# AGENT_OUTPUT_EXPORTER_MAX_TOKENS=8192        ← inherits from default

# -- QA Reviewer --
# Needs strong code-review capabilities to catch syntax errors, missing
# imports, hallucinated variables, and didactic issues in MBO4 lab materials.
# qwen3-coder is purpose-built for code understanding and review tasks.
# NOTE: the reviewer reads every generated file (the largest tool workload of
# any agent).  Keep a generous max_tokens budget — an exhausted budget makes
# the model return NULL/empty content and abort the review with
# "Invalid response from LLM call - None or empty".
AGENT_QA_REVIEWER_MODEL=openrouter/qwen/qwen3-coder
# AGENT_QA_REVIEWER_TEMPERATURE=0.1            ← inherits from default
AGENT_QA_REVIEWER_MAX_TOKENS=32768

# -- Theory Instructor --
# Needs strong writing + code generation for interactive HTML/JS artifacts,
# terminal scripts, and Mermaid.js diagrams. deepseek-v4-pro excels at both
# creative didactic writing and generating correct, runnable code.
AGENT_THEORY_INSTRUCTOR_MODEL=openrouter/deepseek/deepseek-v4-pro
# AGENT_THEORY_INSTRUCTOR_TEMPERATURE=0.2      ← inherits from default
# AGENT_THEORY_INSTRUCTOR_MAX_TOKENS=8192      ← inherits from default
# This agent drives tool calls on a very large prompt.  If you pair it with a
# reasoning model, raise top_p (0.1 is very restrictive and can degenerate
# into empty completions on the tool-calling step):
# AGENT_THEORY_INSTRUCTOR_TOP_P=0.7

# -- Education Director (Blueprint QA) --
# Needs strong reasoning to audit syllabi for time-budget math, realistic
# MBO4 workloads, and scheduling contradictions. deepseek-v4-pro excels at
# structured analysis and precise feasibility calculations.
AGENT_EDUCATION_DIRECTOR_MODEL=openrouter/deepseek/deepseek-v4-pro
# AGENT_EDUCATION_DIRECTOR_TEMPERATURE=0.2     ← inherits from default
# AGENT_EDUCATION_DIRECTOR_MAX_TOKENS=8192     ← inherits from default

# -- Video Engineer (Video-as-Code Specialist) --
# Needs strong code-generation capabilities for React/Remotion JSX
# composition generation. deepseek-v4-pro balances creative temporal
# animation design with correct, runnable TypeScript/JSX output.
AGENT_VIDEO_ENGINEER_MODEL=openrouter/deepseek/deepseek-v4-pro
# AGENT_VIDEO_ENGINEER_TEMPERATURE=0.2         ← inherits from default
# AGENT_VIDEO_ENGINEER_MAX_TOKENS=8192         ← inherits from default

# ============================================================
#  Agent Runtime Limits  (max_iter / max_rpm)
# ============================================================
# Each CrewAI agent has two runtime guardrails:
#   max_iter — maximum tool-calling iterations before forced final answer
#   max_rpm  — maximum API requests per minute (rate limiting)
#
# These follow the SAME 3-tier fallback chain as MODEL/TEMPERATURE/…:
#   1. AGENT_{ROLE}_MAX_ITER / AGENT_{ROLE}_MAX_RPM   ← per-agent override
#   2. AGENT_DEFAULT_MAX_ITER / AGENT_DEFAULT_MAX_RPM ← catch-all default
#   3. Hardcoded defaults in each agent module          ← final fallback
#
# Hardcoded defaults per agent (no env vars needed unless you want
# to override them):
#   CURRICULUM_ARCHITECT   max_iter=5    max_rpm=20
#   EDUCATION_DIRECTOR     max_iter=5    max_rpm=20
#   INTAKE_SPECIALIST      max_iter=5    max_rpm=20
#   LAB_DEVELOPER          max_iter=60   max_rpm=30
#   QA_REVIEWER            max_iter=30   max_rpm=20
#   THEORY_INSTRUCTOR      max_iter=30   max_rpm=20
#
#   ⚠️  NOTE: For agents using reasoning models (Claude Opus 5.5,
#   Sonnet 5, GPT-5), set max_tokens >= 16384. Adaptive reasoning
#   consumes ~8K tokens internally before producing visible output.
#   At max_tokens=8192, the model will return NULL content.
#
# If you see "Maximum iterations reached" errors, increase the
# relevant per-agent limit here.  The QA Reviewer is the most
# likely to need a bump because it must read every generated file
# individually.

# -- Default limits for all agents --
# AGENT_DEFAULT_MAX_ITER=60
# AGENT_DEFAULT_MAX_RPM=20

# -- Per-agent overrides (uncomment to raise) --
# Increase QA Reviewer so it can read 110+ files in one review:
# AGENT_QA_REVIEWER_MAX_ITER=250
# AGENT_LAB_DEVELOPER_MAX_ITER=100
# AGENT_THEORY_INSTRUCTOR_MAX_ITER=60

# ===========================================================================
# FAIL-FAST & PRE-FLIGHT GUARDS
# ===========================================================================
# The swarm treats an empty/NULL model response as a *futile* failure: the
# model has already proven it cannot answer this request, so retrying it only
# burns credits.  These knobs control how aggressively that is enforced.
#
#   AGENT_LLM_FUTILE_RETRIES
#       How many times an empty-response ("Invalid response from LLM call -
#       None or empty") failure may be attempted before the whole run aborts.
#       Default: 1  → abort on the first indication, no wasted retries.
#       Raise it only if your provider is known to emit occasional one-off
#       empty responses.
#       NOTE: genuine transient failures (HTTP 429, timeouts, connection
#       resets) are still retried up to 3 times with exponential backoff —
#       this setting does not affect them.
# AGENT_LLM_FUTILE_RETRIES=1
#
#   SYLLABUS_SKIP_PREFLIGHT
#       Set to 1 to disable BOTH pre-flight gates below.
# SYLLABUS_SKIP_PREFLIGHT=0
#
#   SYLLABUS_PREFLIGHT_PROBE
#       Enables the live model probe: before the pipeline starts, each
#       distinct model is sent ONE tiny tool-calling request.  This is the
#       exact code path (CrewAI's call_llm_native_tools listener) that fails
#       with the empty-response error, so a broken model is detected for the
#       cost of a single small request instead of a whole generation cycle.
#       Default: off (it adds one network round-trip per model).
#       A model that returns nothing is FATAL; an unreachable model only
#       produces a warning.
# SYLLABUS_PREFLIGHT_PROBE=1
#
#   SYLLABUS_PREFLIGHT_PROBE_TIMEOUT
#       Per-request timeout in seconds for the live probe.  Default: 30.
# SYLLABUS_PREFLIGHT_PROBE_TIMEOUT=30
#
# Static pre-flight checks (always on, zero cost, no API calls):
#   * A reasoning model (Claude Opus 5.5 / Sonnet 5 / GPT-5) configured with
#     max_tokens < 16384 is a FATAL misconfiguration and blocks the run.
#   * A reasoning model with top_p < 0.5 is reported as a WARNING.
#
# Exit codes from src/main.py:
#   2  authentication / API-key problem
#   3  unexpected error
#   4  futile LLM failure — the run was aborted early on purpose

# ===========================================================================
# SYSTEM ONE (JEV) — DETERMINISTIC DECISION LAYER
# ===========================================================================
# The pipeline offloads routing, QA scoring and syllabus gating to a fast,
# schema-driven System One model (TypeSafe AI's "Jev").  These decisions are
# non-generative: the model returns typed choice/score/noul answers, never
# prose.  Generative LLMs keep handling all content creation.
#
#   SYSTEM_ONE_API_KEY     API key for the System One provider.
#                          Falls back to TYPESAFE_API_KEY.
#   SYSTEM_ONE_MODEL       Model id/alias.  Default: jev-latest
#   SYSTEM_ONE_BASE_URL    API endpoint.    Default: https://api.typesafe.ai
#   SYSTEM_ONE_TIMEOUT     Per-request timeout in seconds.  Default: 10
#   SYSTEM_ONE_ENABLED     Set to 0 to disable live decisions and fall back to
#                          the degraded offline mode (every answer is returned
#                          with confidence 0.0 so callers escalate).
#
# Per-decision-task model overrides (highest priority):
#   SYSTEM_ONE_{MODALITY_ROUTER|QA_SCORER|SYLLABUS_GATE}_MODEL
#
# Confidence thresholds — decisions below these are flagged for review:
#   SYSTEM_ONE_ROUTING_MIN_CONFIDENCE=0.5
#   SYSTEM_ONE_QA_PASS_THRESHOLD=0.6
#   SYSTEM_ONE_QA_MIN_CONFIDENCE=0.5
#   SYSTEM_ONE_QA_VERDICT_THRESHOLD=0.5
#   SYSTEM_ONE_GATE_VERDICT_THRESHOLD=0.5
#   SYSTEM_ONE_GATE_MIN_CONFIDENCE=0.5
#
# SYSTEM_ONE_API_KEY=your_typesafe_api_key_here
# SYSTEM_ONE_MODEL=jev-latest
# SYSTEM_ONE_TIMEOUT=10
# SYSTEM_ONE_ENABLED=1

